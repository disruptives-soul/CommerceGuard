{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/commerceguard/run",
      "schedule": "0 13 * * *"
    }
  ],
  "functions": {
    "api/commerceguard/run.ts": {
      "maxDuration": 300,
      "includeFiles": "{configs/**,recipes/**,node_modules/@sparticuz/chromium/bin/**}"
    }
  }
}
