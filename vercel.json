{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "env": {
    "PLAYWRIGHT_BROWSERS_PATH": "0"
  },
  "crons": [
    {
      "path": "/api/commerceguard/run",
      "schedule": "0 13 * * *"
    }
  ],
  "functions": {
    "api/commerceguard/run.ts": {
      "maxDuration": 300,
      "includeFiles": "{configs/**,recipes/**,node_modules/playwright-core/.local-browsers/**}"
    }
  }
}
