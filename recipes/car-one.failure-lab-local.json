{
  "id": "car-one-failure-lab-local",
  "name": "Car One local failure lab",
  "projectId": "car-one",
  "adapter": "car-one",
  "reportGroup": "failure-lab",
  "baseUrl": "http://127.0.0.1:4173",
  "stopBeforeIrreversibleAction": true,
  "retry": {
    "attempts": 1,
    "delayMs": 0
  },
  "timeouts": {
    "navigationMs": 7000,
    "stepMs": 5000
  },
  "steps": [
    {
      "id": "open-buy-listing",
      "action": "goto",
      "url": "http://127.0.0.1:4173/comprar",
      "assertions": [
        {
          "type": "urlContains",
          "value": "/comprar"
        },
        {
          "type": "notTextContains",
          "value": "Algo salio mal"
        },
        {
          "type": "notTextContains",
          "value": "No pudimos cargar los autos."
        }
      ]
    },
    {
      "id": "wait-vehicle-card-link",
      "action": "waitForSelector",
      "selector": "[data-cg=\"vehicle-detail-link\"], a[href*=\"/comprar/usados/\"], a[href*=\"/comprar/0km/\"], a[href*=\"/comprar/pda/\"]"
    },
    {
      "id": "open-first-vehicle-detail",
      "action": "clickFirst",
      "selector": "[data-cg=\"vehicle-detail-link\"], a[href*=\"/comprar/usados/\"], a[href*=\"/comprar/0km/\"], a[href*=\"/comprar/pda/\"]",
      "clickPosition": {
        "x": 24,
        "y": 24
      },
      "assertions": [
        {
          "type": "urlContains",
          "value": "/comprar/"
        }
      ]
    },
    {
      "id": "wait-interest-cta",
      "action": "waitForSelector",
      "selector": "[data-cg=\"interest-cta\"], button:has-text(\"Me interesa\")"
    },
    {
      "id": "assert-detail-price",
      "action": "assertText",
      "value": "$"
    },
    {
      "id": "click-interest-cta",
      "action": "clickFirst",
      "selector": "[data-cg=\"interest-cta\"], button:has-text(\"Me interesa\")"
    },
    {
      "id": "stop-before-submit",
      "action": "assertText",
      "value": "Telefono de contacto",
      "assertions": [
        {
          "type": "textContains",
          "value": "Continuar"
        }
      ]
    }
  ]
}
