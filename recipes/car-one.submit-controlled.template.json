{
  "id": "car-one-buy-interest-submit-controlled",
  "name": "Car One controlled interest submit journey",
  "projectId": "car-one",
  "adapter": "car-one",
  "reportGroup": "real",
  "baseUrl": "${CARONE_BASE_URL}",
  "stopBeforeIrreversibleAction": false,
  "safeSubmit": true,
  "safety": {
    "allowedBaseUrlPrefixes": [
      "http://localhost:",
      "http://127.0.0.1:",
      "https://stg.carone.com.ar"
    ],
    "requiredEnv": {}
  },
  "retry": {
    "attempts": 1,
    "delayMs": 0
  },
  "timeouts": {
    "navigationMs": 30000,
    "stepMs": 20000
  },
  "steps": [
    {
      "id": "open-buy-listing",
      "action": "goto",
      "url": "${CARONE_BASE_URL}/comprar",
      "assertions": [
        {
          "type": "urlContains",
          "value": "/comprar"
        },
        {
          "type": "notTextContains",
          "value": "Algo salio mal"
        },
        {
          "type": "notTextContains",
          "value": "No pudimos cargar los autos."
        }
      ]
    },
    {
      "id": "wait-vehicle-card-link",
      "action": "waitForSelector",
      "selector": "[data-cg=\"vehicle-detail-link\"], a[href*=\"/comprar/usados/\"], a[href*=\"/comprar/0km/\"], a[href*=\"/comprar/pda/\"]"
    },
    {
      "id": "open-first-vehicle-detail",
      "action": "clickFirst",
      "selector": "[data-cg=\"vehicle-detail-link\"], a[href*=\"/comprar/usados/\"], a[href*=\"/comprar/0km/\"], a[href*=\"/comprar/pda/\"]",
      "clickPosition": {
        "x": 24,
        "y": 24
      }
    },
    {
      "id": "wait-interest-cta",
      "action": "waitForSelector",
      "selector": "[data-cg=\"interest-cta\"], button:has-text(\"Me interesa\")"
    },
    {
      "id": "assert-detail-price",
      "action": "assertText",
      "value": "$"
    },
    {
      "id": "click-interest-cta",
      "action": "clickFirst",
      "selector": "[data-cg=\"interest-cta\"], button:has-text(\"Me interesa\")"
    },
    {
      "id": "wait-interest-form",
      "action": "assertText",
      "value": "Telefono de contacto"
    },
    {
      "id": "fill-test-name",
      "action": "fill",
      "selector": "[data-cg=\"lead-form-name\"], input#name",
      "value": "${CG_TEST_LEAD_NAME}"
    },
    {
      "id": "fill-test-phone",
      "action": "fill",
      "selector": "[data-cg=\"lead-form-phone\"], input#phone",
      "value": "${CG_TEST_LEAD_PHONE}"
    },
    {
      "id": "capture-before-submit",
      "action": "screenshot",
      "name": "car-one-before-controlled-submit"
    },
    {
      "id": "submit-interest-form",
      "action": "clickFirst",
      "selector": "[data-cg=\"stop-before-submit\"], button:has-text(\"Continuar\")"
    },
    {
      "id": "wait-submit-success",
      "action": "assertText",
      "value": "Gracias por completar tus datos",
      "assertions": [
        {
          "type": "textContains",
          "value": "Seguir configurando"
        }
      ]
    },
    {
      "id": "capture-submit-success",
      "action": "screenshot",
      "name": "car-one-submit-success"
    }
  ]
}
